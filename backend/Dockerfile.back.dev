FROM php:8.4-cli

RUN apt-get update && apt-get install -y unzip && docker-php-ext-install pdo_mysql

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

CMD ["sh", "-c", "composer install && (grep -q '^APP_KEY=.' .env || php artisan key:generate) && php artisan migrate --force && php artisan serve --host=0.0.0.0 --port=8000 --no-reload"]